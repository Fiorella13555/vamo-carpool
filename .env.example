# Copia este archivo a .env.local y completa con tus valores.
# .env.local nunca se sube a git (ver .gitignore: *.local).

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Google Maps (Google Cloud Console -> Credentials)
# Habilitar: Maps JavaScript API, Routes API y Places API (New) (NO "Directions API", deprecada)
VITE_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps
# Map ID de Google para marcadores avanzados; DEMO_MAP_ID sirve para pruebas.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Modo prueba (opcional): deja fijar una ubicación manual por GPS simulado
# en vez de depender del GPS real del celular, y sube la tolerancia de
# cercanía a la ruta. Útil para probar con gente que no está físicamente
# sobre la ruta. Déjalo en "false" o bórralo fuera de las pruebas.
VITE_TEST_MODE=false
VITE_TEST_TOLERANCE_M=2000

# Servicio Python conservado: ranking académico anterior y pronósticos sintéticos.
# La búsqueda unificada usa AHP/Fuzzy en TypeScript sin depender de este servicio.
# Sin URL, /pronosticos muestra un ejemplo guardado.
# Para consultas interactivas, desplegar recommendation-service/ y usar su URL HTTPS.
# Local: http://localhost:8000 (ver recommendation-service/FORECASTING.md).
VITE_RECOMMENDATION_API_URL=
